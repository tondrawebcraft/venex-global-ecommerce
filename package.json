{
  "name": "venex-global",
  "version": "1.0.0",
  "private": true,
  "description": "VENEX GLOBAL commerce platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:api": "npm run dev --prefix backend",
    "dev:web": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend && npm run lint --prefix backend",
    "seed": "npm run seed --prefix backend",
    "test": "npm run test --prefix backend && npm run test --prefix frontend",
    "smoke": "npm run smoke --prefix backend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "@eslint/js": "^9.19.0",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.3"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}

